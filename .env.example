# ==============================================================================
# DataNexus Platform Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# ==============================================================================

# Local MySQL Database (Orders Service)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=orders_db

# Local PostgreSQL Database (Users & Inventory Service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DATABASE=users_db

# Apache Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_URL=http://localhost:8083

# Apache Spark Master
SPARK_MASTER_URL=spark://localhost:7077

# AWS Cloud Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_DATALAKE_BUCKET=datanexus-datalake-analytics-dev
GLUE_DATABASE_NAME=datanexus_catalog

# GCP Cloud Configuration
GCP_PROJECT_ID=datanexus-506318
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
BIGQUERY_RAW_DATASET=datanexus_raw
BIGQUERY_STAGING_DATASET=datanexus_staging
BIGQUERY_ANALYTICS_DATASET=datanexus_analytics

# Apache Airflow Orchestration
AIRFLOW_HOME=/Users/abhishekshankar/PROJECTS/DataNexus/orchestration

# dbt Data Warehouse
DBT_PROFILES_DIR=/Users/abhishekshankar/PROJECTS/DataNexus/warehouse/dbt_datanexus

# Serving API (FastAPI)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
