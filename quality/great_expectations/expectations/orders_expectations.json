{
  "data_asset_type": null,
  "expectation_suite_name": "orders_suite",
  "ge_cloud_id": null,
  "meta": {
    "great_expectations_version": "0.18.0",
    "created_by": "datanexus-data-engineering",
    "created_at": "2025-01-01T00:00:00.000000Z",
    "notes": "Expectation suite for the Silver zone orders table. Validated at the Bronze to Silver boundary."
  },
  "expectations": [
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "order_id" },
      "meta": { "notes": "Primary key column must exist." }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "user_id" },
      "meta": { "notes": "Foreign key to users table must exist." }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "total_amount" },
      "meta": { "notes": "Order value column must exist." }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "status" },
      "meta": { "notes": "Order lifecycle status column must exist." }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "city" },
      "meta": { "notes": "Delivery city column must exist." }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "created_at" },
      "meta": { "notes": "Order creation timestamp column must exist." }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "order_id" },
      "meta": { "notes": "Every row must have a non-null order_id." }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "user_id" },
      "meta": { "notes": "Every order must be associated with a user." }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "total_amount" },
      "meta": { "notes": "Order amount must never be null." }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "total_amount",
        "min_value": 0,
        "max_value": 100000,
        "mostly": 1.0
      },
      "meta": {
        "notes": "Order amounts must be within a valid business range [0, 100000]. Values outside this range indicate bad data."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "status",
        "value_set": ["COMPLETED", "PENDING", "CANCELLED", "PROCESSING"],
        "mostly": 1.0
      },
      "meta": { "notes": "Only known lifecycle statuses are permitted." }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "order_id",
        "regex": "^ord-",
        "mostly": 1.0
      },
      "meta": { "notes": "All order IDs must follow the 'ord-' prefix convention." }
    }
  ]
}
