[mysqld]
# Unique server ID required for replication and Debezium CDC
server-id        = 223344

# Enable binary logging with prefix 'mysql-bin'
log_bin          = mysql-bin

# Row-based logging captures exact row modifications (required for Debezium CDC)
binlog_format    = ROW

# Captures complete row state before and after modification
binlog_row_image = FULL

# Retain binary logs for 7 days
expire_logs_days = 7
